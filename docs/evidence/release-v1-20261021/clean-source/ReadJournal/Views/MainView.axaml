<UserControl xmlns:vm="using:ReadJournal.Library.ViewModels" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.MainView"><Grid ColumnDefinitions="210,*"><Border Classes="nav" Background="#173D36" Padding="20,28"><StackPanel Spacing="18"><TextBlock Text="阅 记" FontSize="30" FontWeight="Bold" Foreground="White"/><TextBlock Text="让每一页，留下回响" Foreground="#C0D3CD" Margin="0,0,0,24"/><ItemsControl ItemsSource="{x:Static vm:MenuItem.MenuItems}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Name}" Margin="0,4" HorizontalAlignment="Stretch" Command="{Binding $parent[UserControl].DataContext.OnMenuTappedCommand}" CommandParameter="{Binding}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><Grid Grid.Column="1" RowDefinitions="Auto,*"><Border Padding="28,16" BorderThickness="0,0,0,1" BorderBrush="#8094A49C"><DockPanel><Button DockPanel.Dock="Left" Content="← 返回" IsVisible="{Binding CanGoBack}" ToolTip.Tip="返回当前模块的上一页" Command="{Binding GoBackCommand}" Margin="0,0,16,0"/><TextBlock Classes="h2" Text="{Binding Title}" VerticalAlignment="Center"/></DockPanel></Border><ContentControl Grid.Row="1" Content="{Binding Content}" Margin="30,24"/></Grid></Grid></UserControl>
