<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.ReadingPlanListView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding ReadingPlanListViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<Grid RowDefinitions="Auto,Auto,Auto,*"><DockPanel><Button DockPanel.Dock="Right" Content="＋ 制定计划" Command="{Binding AddPlanCommand}"/><TextBlock Classes="h1" Text="阅读计划"/></DockPanel><StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,18"><ComboBox Width="160" ItemsSource="{Binding States}" SelectedItem="{Binding State,Mode=TwoWay}"/><Button Content="筛选 / 刷新" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><ScrollViewer Grid.Row="3"><StackPanel><TextBlock Text="没有匹配的计划。先为一本书设定阅读目标吧。" IsVisible="{Binding IsEmpty}" Classes="muted" Margin="0,20"/><ItemsControl ItemsSource="{Binding PlansList}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="#8094A49C" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,14"><StackPanel Spacing="12"><TextBlock Classes="h2" Text="{Binding Progress.Book.Title}"/><TextBlock Text="{Binding Deadline}" Classes="muted"/><TextBlock Text="{Binding Suggestion}"/><ProgressBar Maximum="100" Value="{Binding Progress.Percent}"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="编辑计划" Command="{Binding $parent[UserControl].DataContext.EditPlanCommand}" CommandParameter="{Binding}"/><Button Content="删除计划" Command="{Binding $parent[UserControl].DataContext.DeletePlanCommand}" CommandParameter="{Binding}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid>
</UserControl>
