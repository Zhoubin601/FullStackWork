<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:ReadJournal" x:Class="ReadJournal.App" RequestedThemeVariant="Light">
<Application.Resources><ResourceDictionary>
<ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
 <Setter Property="Background" Value="#60798A80"/><Setter Property="Foreground" Value="#399B75"/>
 <Setter Property="MinHeight" Value="6"/><Setter Property="CornerRadius" Value="4"/>
 <Setter Property="Template"><ControlTemplate>
  <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
   <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" HorizontalAlignment="Left"/>
  </Border>
 </ControlTemplate></Setter>
</ControlTheme><local:ServiceLocator x:Key="ServiceLocator"/></ResourceDictionary></Application.Resources>
<Application.DataTemplates><local:ViewLocator/></Application.DataTemplates>
<Application.Styles><FluentTheme/>
<Style Selector="Window"><Setter Property="FontFamily" Value="Noto Sans CJK SC,Microsoft YaHei,Arial"/></Style>
<Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
<Style Selector="TextBlock.muted"><Setter Property="Opacity" Value="0.65"/></Style>
<Style Selector="Button"><Setter Property="Padding" Value="16,10"/></Style>
<Style Selector="TextBox"><Setter Property="MinHeight" Value="40"/></Style>
<Style Selector="Border.nav Button"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#254C44"/></Style>
<Style Selector="Button.primary"><Setter Property="Background" Value="#246650"/><Setter Property="Foreground" Value="White"/></Style>
</Application.Styles></Application>
