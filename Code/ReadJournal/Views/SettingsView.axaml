<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.SettingsView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding SettingsViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<ScrollViewer><StackPanel Spacing="18" MaxWidth="780"><TextBlock Classes="h1" Text="设置与数据"/><TextBlock Classes="h2" Text="外观"/><StackPanel Orientation="Horizontal" Spacing="12"><ComboBox Width="180" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme,Mode=TwoWay}"/><Button Content="应用主题" Command="{Binding ApplyThemeCommand}"/></StackPanel><Border BorderBrush="#8094A49C" BorderThickness="0,1,0,0" Margin="0,12"/><TextBlock Classes="h2" Text="业务数据备份"/><TextBlock Text="完整 ZIP 包含全部业务数据、电子书原文件、规范化正文和本地资源。恢复会整体替换当前书库，旧 JSON 仅用于恢复手动书籍；校验并生成完整自动备份后才替换。本机主题和密钥保留。" TextWrapping="Wrap" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="导出完整 ZIP 备份" Command="{Binding ExportCommand}"/><Button Content="从 ZIP / 旧 JSON 恢复" Command="{Binding RestoreCommand}"/></StackPanel><Border BorderBrush="#8094A49C" BorderThickness="0,1,0,0" Margin="0,12"/><TextBlock Classes="h2" Text="试用演示"/><TextBlock Text="仅在空业务库可载入。所有书籍、作者及摘录均为虚构演示资料。" Classes="muted" TextWrapping="Wrap"/><Button Content="载入虚构演示数据" Command="{Binding LoadDemoCommand}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><TextBlock Text="正在处理…" IsVisible="{Binding IsBusy}" Classes="muted"/><Button Content="刷新 / 重试" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/></StackPanel></ScrollViewer>
</UserControl>
