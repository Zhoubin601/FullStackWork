<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.SettingsView">
  <i:Interaction.Behaviors>
    <ia:EventTriggerBehavior EventName="Loaded">
      <ia:InvokeCommandAction Command="{Binding SettingsViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/>
    </ia:EventTriggerBehavior>
  </i:Interaction.Behaviors>
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,0,16">
      <DockPanel>
        <Button DockPanel.Dock="Right" Classes="secondary" Content="刷新 / 重试" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/>
        <StackPanel Spacing="2">
          <TextBlock Classes="h1" Text="设置与数据"/>
          <TextBlock Classes="muted" Text="配置界面主题、AI 阅读助手服务与全量 ZIP 数据备份恢复"/>
        </StackPanel>
      </DockPanel>

      <TextBlock Text="{Binding Status}" FontWeight="Medium" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Error}" Classes="danger-text" TextWrapping="Wrap"/>
      <TextBlock Text="正在处理…" IsVisible="{Binding IsBusy}" Classes="muted"/>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="外观主题"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <ComboBox Width="200" ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme,Mode=TwoWay}"/>
            <Button Classes="primary" Content="应用主题" Command="{Binding ApplyThemeCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="AI 阅读助手"/>
          <TextBlock Text="默认本地模拟，不联网、不需要密钥。真实模式只发送确认范围内的正文，可能计费。密钥仅在本次应用会话内存中保留，退出后需重新输入，不写入备份。" TextWrapping="Wrap" Classes="muted"/>
          <CheckBox Content="使用本地模拟（Mock）" IsChecked="{Binding UseMock}"/>

          <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
              <TextBlock Classes="h3" Text="HTTPS 地址"/>
              <TextBox Text="{Binding AiEndpoint}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
              <TextBlock Classes="h3" Text="模型（deepseek-chat / deepseek-reasoner）"/>
              <TextBox Text="{Binding AiModel}"/>
            </StackPanel>
          </Grid>

          <WrapPanel>
            <StackPanel Width="180" Spacing="6" Margin="0,0,12,0">
              <TextBlock Classes="h3" Text="输入字符上限"/>
              <TextBox Text="{Binding AiInputLimit}"/>
            </StackPanel>
            <StackPanel Width="180" Spacing="6" Margin="0,0,12,0">
              <TextBlock Classes="h3" Text="输出 token 上限"/>
              <TextBox Text="{Binding AiOutputLimit}"/>
            </StackPanel>
            <StackPanel Width="180" Spacing="6">
              <TextBlock Classes="h3" Text="超时秒数"/>
              <TextBox Text="{Binding AiTimeoutSeconds}"/>
            </StackPanel>
          </WrapPanel>

          <CheckBox Content="我了解真实模式会将确认范围正文发送至 DeepSeek" IsChecked="{Binding UploadAcknowledged}"/>
          <Button Classes="primary" Content="保存 AI 配置" Command="{Binding SaveAiSettingsCommand}" HorizontalAlignment="Left"/>

          <Border Classes="surface-muted" Padding="14,12" Margin="0,4,0,0">
            <StackPanel Spacing="10">
              <TextBlock Classes="h3" Text="会话 API 密钥（仅内存保存）"/>
              <TextBox Name="ApiKeyBox" PasswordChar="●" Text="{Binding ApiKeyInput}" Watermark="输入会话 API Key（本地模拟无需填写）"/>
              <WrapPanel>
                <Button Classes="primary" Content="保存会话密钥" Command="{Binding SaveApiKeyCommand}" Margin="0,0,10,0"/>
                <Button Classes="danger" Content="删除会话密钥" Command="{Binding DeleteApiKeyCommand}"/>
              </WrapPanel>
              <TextBlock Text="{Binding CredentialStatus}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="业务数据备份"/>
          <TextBlock Text="完整 ZIP 包含全部业务数据、电子书原文件、规范化正文和本地资源。恢复会整体替换当前书库，旧 JSON 仅用于恢复手动书籍；校验并生成完整自动备份后才替换。本机主题和密钥保留。" TextWrapping="Wrap" Classes="muted"/>
          <StackPanel Orientation="Horizontal" Spacing="12">
            <Button Classes="primary" Content="导出完整 ZIP 备份" Command="{Binding ExportCommand}"/>
            <Button Classes="secondary" Content="从 ZIP / 旧 JSON 恢复" Command="{Binding RestoreCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="试用演示"/>
          <TextBlock Text="仅在空业务库可载入。所有书籍、作者及摘录均为虚构演示资料。" Classes="muted" TextWrapping="Wrap"/>
          <Button Classes="secondary" Content="载入虚构演示数据" Command="{Binding LoadDemoCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
