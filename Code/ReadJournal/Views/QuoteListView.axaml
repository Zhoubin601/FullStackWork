<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.QuoteListView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding QuoteListViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<Grid RowDefinitions="Auto,Auto,Auto,*"><DockPanel><Button DockPanel.Dock="Right" Content="＋ 添加书摘" Command="{Binding AddQuoteCommand}"/><TextBlock Classes="h1" Text="书摘收藏"/></DockPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,18"><TextBox Width="300" Watermark="搜索摘录内容或书名" Text="{Binding Query,Mode=TwoWay}"/><CheckBox Content="仅收藏" IsChecked="{Binding FavoritesOnly,Mode=TwoWay}"/><Button Content="搜索 / 刷新" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/></StackPanel><TextBlock Grid.Row="2" Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/>
<ScrollViewer Grid.Row="3"><StackPanel><TextBlock Text="没有匹配的书摘。记录一句打动你的话吧。" IsVisible="{Binding IsEmpty}" Classes="muted" Margin="0,20"/><ItemsControl ItemsSource="{Binding QuotesList}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="1" BorderBrush="#8094A49C" CornerRadius="10" Padding="22" Margin="0,0,0,14"><StackPanel Spacing="12"><TextBlock Text="{Binding Location}" Classes="muted"/><TextBlock Text="{Binding Quote}" Classes="h2" TextWrapping="Wrap"/><TextBlock Text="{Binding Quote.Thoughts}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Spacing="10"><Button Content="编辑" Command="{Binding $parent[UserControl].DataContext.EditQuoteCommand}" CommandParameter="{Binding}"/><Button Content="切换收藏" Command="{Binding $parent[UserControl].DataContext.ToggleFavoriteCommand}" CommandParameter="{Binding}"/><Button Content="删除" Command="{Binding $parent[UserControl].DataContext.DeleteQuoteCommand}" CommandParameter="{Binding}"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Grid>
</UserControl>
