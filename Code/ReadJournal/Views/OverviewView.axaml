<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.OverviewView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding OverviewViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<ScrollViewer><StackPanel Spacing="20"><TextBlock Classes="h1" Text="今天，也读一会儿"/><TextBlock Classes="muted" Text="从一本书开始，积累你的阅读轨迹。"/><Border Padding="24" BorderBrush="#8094A49C" BorderThickness="1" CornerRadius="12"><StackPanel Spacing="16"><TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Classes="h2"/><Button Content="前往我的书库 →" Command="{Binding OpenLibraryCommand}"/></StackPanel></Border><TextBlock Classes="h2" Text="正在阅读"/><ItemsControl ItemsSource="{Binding ReadingBooks}"><ItemsControl.ItemTemplate><DataTemplate><Button HorizontalAlignment="Stretch" Margin="0,4" Command="{Binding $parent[UserControl].DataContext.OpenBookCommand}" CommandParameter="{Binding}"><StackPanel Spacing="6"><TextBlock Text="{Binding Book.Title}"/><TextBlock Text="{Binding ProgressText}" Classes="muted"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="h2" Text="近期记录"/><ItemsControl ItemsSource="{Binding RecentRecords}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Margin="0,5" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="h2" Text="待完成计划"/><ItemsControl ItemsSource="{Binding PendingPlans}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5" Spacing="5"><TextBlock Text="{Binding Progress.Book.Title}"/><TextBlock Text="{Binding Suggestion}" Classes="muted"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><Button Content="刷新 / 重试" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/></StackPanel></ScrollViewer>
</UserControl>
