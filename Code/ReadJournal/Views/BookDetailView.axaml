<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.BookDetailView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding BookDetailViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<ScrollViewer><StackPanel Spacing="14">
<TextBlock Classes="h1" Text="{Binding Book.Title}"/><TextBlock Text="{Binding Book.Author}" Classes="muted"/><TextBlock Text="{Binding Book.Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding Progress.ProgressText}"/><ProgressBar Value="{Binding Progress.Percent}" Maximum="100"/><TextBlock Text="{Binding Progress.ActivityText}"/>
<WrapPanel><Button Content="编辑资料" Command="{Binding EditBookCommand}" Margin="0,0,10,10"/><Button Content="＋ 阅读记录" Command="{Binding AddRecordCommand}" IsVisible="{Binding CanAddManualRecord}" Margin="0,0,10,10"/><Button Content="＋ 书摘" Command="{Binding AddQuoteCommand}" Margin="0,0,10,10"/><Button Content="＋ 阅读计划" Command="{Binding AddPlanCommand}" Margin="0,0,10,10"/><Button Content="删除书籍" Command="{Binding DeleteBookCommand}" Margin="0,0,10,10"/></WrapPanel>
<TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><Button Content="刷新 / 重试" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/>
<TextBlock Classes="h2" Text="阅读记录"/><ItemsControl ItemsSource="{Binding RecordsList}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderThickness="0,0,0,1" BorderBrush="#8094A49C" Padding="0,12"><Grid ColumnDefinitions="*,Auto,Auto"><TextBlock Text="{Binding}" VerticalAlignment="Center"/><Button Grid.Column="1" Content="修改" Margin="8,0" Command="{Binding $parent[UserControl].DataContext.EditRecordCommand}" CommandParameter="{Binding}"/><Button Grid.Column="2" Content="删除" Command="{Binding $parent[UserControl].DataContext.DeleteRecordCommand}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Classes="h2" Text="关联计划"/><ItemsControl ItemsSource="{Binding PlansList}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="5" Margin="0,5"><TextBlock Text="{Binding Deadline}"/><TextBlock Text="{Binding Suggestion}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Classes="h2" Text="关联书摘" Margin="0,12,0,0"/><ItemsControl ItemsSource="{Binding QuotesList}"><ItemsControl.ItemTemplate><DataTemplate><Button HorizontalAlignment="Stretch" Margin="0,5" Command="{Binding $parent[UserControl].DataContext.EditQuoteCommand}" CommandParameter="{Binding}"><TextBlock Text="{Binding Quote.Text}" TextWrapping="Wrap"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer>
</UserControl>
