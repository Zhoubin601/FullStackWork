<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.BookDetailView">
  <i:Interaction.Behaviors>
    <ia:EventTriggerBehavior EventName="Loaded">
      <ia:InvokeCommandAction Command="{Binding BookDetailViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/>
    </ia:EventTriggerBehavior>
  </i:Interaction.Behaviors>
  <ScrollViewer>
    <StackPanel Spacing="16" Margin="0,0,0,16">
      <Border Classes="card">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="h1" Text="{Binding Book.Title}" VerticalAlignment="Center"/>
            <Border Classes="badge">
              <TextBlock Classes="badge-text" Text="{Binding Progress.KindLabel}"/>
            </Border>
            <Border Classes="badge-amber">
              <TextBlock Classes="badge-amber-text" Text="{Binding Progress.State}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding Book.Author}" Classes="muted" IsVisible="{Binding Book.Author, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
          <TextBlock Text="{Binding Book.Description}" TextWrapping="Wrap" IsVisible="{Binding Book.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

          <Border Classes="surface-muted" Padding="14,12">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding Progress.ProgressText}" FontWeight="Medium"/>
              <ProgressBar Value="{Binding Progress.Percent}" Maximum="100" Height="8"/>
              <TextBlock Text="{Binding Progress.ActivityText}" Classes="muted"/>
            </StackPanel>
          </Border>

          <WrapPanel Margin="0,4,0,0">
            <Button Classes="primary" Content="开始 / 继续阅读" Command="{Binding OpenReaderCommand}" IsVisible="{Binding IsEbook}" Margin="0,0,10,8"/>
            <Button Classes="secondary" Content="编辑资料" Command="{Binding EditBookCommand}" Margin="0,0,10,8"/>
            <Button Classes="secondary" Content="＋ 阅读记录" Command="{Binding AddRecordCommand}" IsVisible="{Binding CanAddManualRecord}" Margin="0,0,10,8"/>
            <Button Classes="secondary" Content="＋ 书摘" Command="{Binding AddQuoteCommand}" Margin="0,0,10,8"/>
            <Button Classes="secondary" Content="＋ 阅读计划" Command="{Binding AddPlanCommand}" Margin="0,0,10,8"/>
            <Button Classes="secondary" Content="刷新 / 重试" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}" Margin="0,0,10,8"/>
            <Button Classes="danger" Content="删除书籍" Command="{Binding DeleteBookCommand}" Margin="0,0,0,8"/>
          </WrapPanel>

          <Border Classes="error-banner" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Error}" Classes="danger-text" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="h2" Text="阅读历史"/>
          <Border Classes="surface-muted" Padding="14,10" IsVisible="{Binding !HasHistory}">
            <TextBlock Text="暂无阅读历史活动。" Classes="muted"/>
          </Border>
          <ItemsControl ItemsSource="{Binding HistoryList}" IsVisible="{Binding HasHistory}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="surface-muted" Padding="14,10" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="secondary" Content="修改" IsVisible="{Binding CanEdit}" Command="{Binding $parent[UserControl].DataContext.EditHistoryCommand}" CommandParameter="{Binding}" Margin="8,0"/>
                    <Button Grid.Column="2" Classes="danger" Content="删除活动" Command="{Binding $parent[UserControl].DataContext.DeleteHistoryCommand}" CommandParameter="{Binding}"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding HasHistory}">
            <Button Classes="secondary" Content="上一页历史" Command="{Binding PreviousHistoryCommand}"/>
            <TextBlock Text="{Binding HistoryPageText}" VerticalAlignment="Center" FontWeight="Medium"/>
            <Button Classes="secondary" Content="下一页历史" Command="{Binding NextHistoryCommand}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="关联计划"/>
          <Border Classes="surface-muted" Padding="14,10" IsVisible="{Binding !HasPlans}">
            <TextBlock Text="本书暂未设定阅读计划。" Classes="muted"/>
          </Border>
          <ItemsControl ItemsSource="{Binding PlansList}" IsVisible="{Binding HasPlans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="surface-muted" Padding="14,10" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{Binding Deadline}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Suggestion}" Classes="muted"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Classes="h2" Text="关联书摘"/>
          <Border Classes="surface-muted" Padding="14,10" IsVisible="{Binding !HasQuotes}">
            <TextBlock Text="本书暂无关联书摘。" Classes="muted"/>
          </Border>
          <ItemsControl ItemsSource="{Binding QuotesList}" IsVisible="{Binding HasQuotes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="surface-muted" Padding="14,12" Margin="0,0,0,8">
                  <StackPanel Spacing="8">
                    <Button Classes="card-action"
                            Command="{Binding $parent[UserControl].DataContext.EditQuoteCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding Quote.Text}" TextWrapping="Wrap"/>
                    </Button>
                    <Button Classes="secondary"
                            Content="回到原文"
                            IsVisible="{Binding CanOpenSource}"
                            HorizontalAlignment="Left"
                            Command="{Binding $parent[UserControl].DataContext.OpenQuoteSourceCommand}"
                            CommandParameter="{Binding}"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
