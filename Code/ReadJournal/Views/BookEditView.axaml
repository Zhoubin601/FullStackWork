<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.BookEditView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding BookEditViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<ScrollViewer><StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Stretch"><TextBlock Classes="h1" Text="编辑书籍" Margin="0,0,0,12"/><TextBlock Text="书名 *"/><TextBox Text="{Binding Title,Mode=TwoWay}"/><TextBlock Text="作者"/><TextBox Text="{Binding Author,Mode=TwoWay}"/><TextBlock Text="分类"/><TextBox Text="{Binding Category,Mode=TwoWay}"/><TextBlock Text="总页数 *"/><TextBox Text="{Binding TotalPages,Mode=TwoWay}"/><TextBlock Text="简介"/><TextBox Text="{Binding Description,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><TextBlock Text="正在处理…" IsVisible="{Binding IsBusy}" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12"><Button Content="保存并返回" Command="{Binding SaveCommand}"/><TextBlock Text="有未保存修改" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" Classes="muted"/></StackPanel></StackPanel></ScrollViewer>
</UserControl>
