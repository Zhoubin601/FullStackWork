<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.BookEditView">
  <i:Interaction.Behaviors>
    <ia:EventTriggerBehavior EventName="Loaded">
      <ia:InvokeCommandAction Command="{Binding BookEditViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/>
    </ia:EventTriggerBehavior>
  </i:Interaction.Behaviors>
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="编辑书籍"/>
        <TextBlock Classes="muted" Text="维护书籍基本元信息；带 * 号字段为必填项"/>
      </StackPanel>

      <Border Classes="card" Padding="24,20">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="书名 *"/>
            <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding Title,Mode=TwoWay}" Watermark="请输入书籍名称"/>
          </StackPanel>

          <Grid ColumnDefinitions="*,*">
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,8,0">
              <TextBlock Classes="h3" Text="作者"/>
              <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding Author,Mode=TwoWay}" Watermark="作者姓名"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,0">
              <TextBlock Classes="h3" Text="分类"/>
              <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding Category,Mode=TwoWay}" Watermark="如：文学 / 历史 / 技术"/>
            </StackPanel>
          </Grid>

          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="总页数 *"/>
            <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding TotalPages,Mode=TwoWay}" Watermark="请输入正整数页数"/>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="简介"/>
            <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding Description,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" Watermark="简要记录书籍梗概或阅读初衷"/>
          </StackPanel>

          <TextBlock Text="{Binding Error}" Classes="danger-text" TextWrapping="Wrap"/>
          <TextBlock Text="正在处理…" IsVisible="{Binding IsBusy}" Classes="muted"/>

          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
            <Button Classes="primary" IsEnabled="{Binding !IsBusy}" Content="保存并返回" Command="{Binding SaveCommand}"/>
            <Button Classes="secondary" IsEnabled="{Binding !IsBusy}" Content="重新加载" Command="{Binding OnLoadedCommand}"/>
            <Border Classes="badge-amber" IsVisible="{Binding IsDirty}" VerticalAlignment="Center">
              <TextBlock Classes="badge-amber-text" Text="有未保存修改"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
