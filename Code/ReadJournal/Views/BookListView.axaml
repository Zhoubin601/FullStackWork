<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.BookListView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding BookListViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
<DockPanel><Button DockPanel.Dock="Right" Content="＋ 添加书籍" Command="{Binding AddBookCommand}"/><TextBlock Classes="h1" Text="我的书库"/></DockPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,14,0,0"><ComboBox Width="120" ToolTip.Tip="编码选择仅用于TXT；EPUB按规范解析。" ItemsSource="{Binding ImportEncodings}" SelectedItem="{Binding ImportEncoding,Mode=TwoWay}"/><Button Content="导入 TXT / EPUB" Command="{Binding ImportBooksCommand}"/><Button Content="取消导入" Command="{Binding CancelImportCommand}" IsVisible="{Binding IsImporting}"/><Button Content="扫描收件区" Command="{Binding ScanInboxCommand}"/><Button Content="打开收件目录" Command="{Binding OpenInboxCommand}"/></StackPanel>
<StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,18"><TextBox Width="300" Watermark="搜索书名或作者" Text="{Binding Query,Mode=TwoWay}"/><ComboBox Width="110" ItemsSource="{Binding States}" SelectedItem="{Binding State,Mode=TwoWay}"/><Button Content="搜索 / 刷新" Command="{Binding SearchCommand}"/></StackPanel>
<StackPanel Grid.Row="3"><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><TextBlock Text="{Binding OperationMessage}" TextWrapping="Wrap" MaxHeight="100"/></StackPanel>
<ScrollViewer Grid.Row="4"><StackPanel><TextBlock Text="还没有匹配的书籍。试试更换条件，或添加第一本书。" IsVisible="{Binding IsEmpty}" Classes="muted" Margin="0,24"/>
<ItemsControl ItemsSource="{Binding BooksPage}"><ItemsControl.ItemTemplate><DataTemplate><Border Padding="20" Margin="0,0,0,12" BorderBrush="#8094A49C" BorderThickness="1" CornerRadius="10"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="8"><TextBlock Classes="h2" Text="{Binding Book.Title}"/><TextBlock Text="{Binding Book.Author}" Classes="muted"/><TextBlock Text="{Binding ProgressText}"/><ProgressBar Maximum="100" Value="{Binding Percent}" Height="5"/></StackPanel><Button Grid.Column="1" Content="打开 →" VerticalAlignment="Center" Command="{Binding $parent[UserControl].DataContext.OpenBookCommand}" CommandParameter="{Binding}"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
</StackPanel></ScrollViewer><StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="14" Margin="0,12,0,0"><Button Content="上一页" Command="{Binding PreviousPageCommand}"/><TextBlock Text="{Binding PageText}" VerticalAlignment="Center"/><Button Content="下一页" Command="{Binding NextPageCommand}"/></StackPanel></Grid>
</UserControl>
