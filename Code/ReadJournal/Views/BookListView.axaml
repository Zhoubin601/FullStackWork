<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.BookListView">
  <i:Interaction.Behaviors>
    <ia:EventTriggerBehavior EventName="Loaded">
      <ia:InvokeCommandAction Command="{Binding BookListViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/>
    </ia:EventTriggerBehavior>
  </i:Interaction.Behaviors>
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Classes="primary" Content="＋ 添加书籍" Command="{Binding AddBookCommand}"/>
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="我的书库"/>
        <TextBlock Classes="muted" Text="统一管理手动登记藏书与本地 TXT / EPUB 电子书"/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Classes="surface-muted" Padding="14,10" Margin="0,0,0,10">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="电子书收件与导入：" Classes="muted" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox Width="120" ToolTip.Tip="编码选择仅用于TXT；EPUB按规范解析。" ItemsSource="{Binding ImportEncodings}" SelectedItem="{Binding ImportEncoding,Mode=TwoWay}" Margin="0,0,8,0"/>
        <Button Classes="primary" Content="导入 TXT / EPUB" Command="{Binding ImportBooksCommand}" Margin="0,0,8,0"/>
        <Button Classes="danger" Content="取消导入" Command="{Binding CancelImportCommand}" IsVisible="{Binding IsImporting}" Margin="0,0,8,0"/>
        <Button Classes="secondary" Content="扫描收件区" Command="{Binding ScanInboxCommand}" Margin="0,0,8,0"/>
        <Button Classes="secondary" Content="打开收件目录" Command="{Binding OpenInboxCommand}"/>
      </WrapPanel>
    </Border>

    <Border Grid.Row="2" Classes="card-compact" Padding="14,10" Margin="0,0,0,10">
      <WrapPanel VerticalAlignment="Center">
        <TextBox Width="300" Watermark="搜索书名或作者" Text="{Binding Query,Mode=TwoWay}" Margin="0,0,10,0"/>
        <ComboBox Width="120" ItemsSource="{Binding States}" SelectedItem="{Binding State,Mode=TwoWay}" Margin="0,0,10,0"/>
        <Button Classes="primary" Content="搜索 / 刷新" Command="{Binding SearchCommand}"/>
      </WrapPanel>
    </Border>

    <StackPanel Grid.Row="3" Spacing="6">
      <Border Classes="error-banner" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,0,0,6">
        <TextBlock Text="{Binding Error}" Classes="danger-text" TextWrapping="Wrap"/>
      </Border>
      <Border Classes="surface-muted" Padding="12,8" IsVisible="{Binding OperationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Margin="0,0,0,6">
        <TextBlock Text="{Binding OperationMessage}" Classes="muted" TextWrapping="Wrap" MaxHeight="100"/>
      </Border>
    </StackPanel>

    <ScrollViewer Grid.Row="4">
      <StackPanel Spacing="2" Margin="0,0,6,0">
        <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="32,28" Margin="0,12">
          <StackPanel HorizontalAlignment="Center" Spacing="10">
            <PathIcon Data="{StaticResource IconBooks}" Width="28" Height="28" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="还没有匹配的书籍。试试更换条件，或添加第一本书。" Classes="muted" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding BooksPage}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Padding="20,16" Margin="0,0,0,12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="h2" Text="{Binding Book.Title}" VerticalAlignment="Center"/>
                      <Border Classes="badge">
                        <TextBlock Classes="badge-text" Text="{Binding KindLabel}"/>
                      </Border>
                      <Border Classes="badge-amber">
                        <TextBlock Classes="badge-amber-text" Text="{Binding State}"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Book.Author}" Classes="muted" IsVisible="{Binding Book.Author, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding ProgressText}"/>
                    <ProgressBar Maximum="100" Value="{Binding Percent}" Height="6"/>
                  </StackPanel>
                  <Button Grid.Column="1"
                          Classes="primary"
                          Content="打开 →"
                          VerticalAlignment="Center"
                          Margin="16,0,0,0"
                          Command="{Binding $parent[UserControl].DataContext.OpenBookCommand}"
                          CommandParameter="{Binding}"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="5" Classes="card-compact" Padding="14,8" Margin="0,10,0,0" IsVisible="{Binding !IsEmpty}">
      <StackPanel Orientation="Horizontal" Spacing="14" HorizontalAlignment="Center">
        <Button Classes="secondary" Content="上一页" Command="{Binding PreviousPageCommand}"/>
        <TextBlock Text="{Binding PageText}" FontWeight="Medium" VerticalAlignment="Center"/>
        <Button Classes="secondary" Content="下一页" Command="{Binding NextPageCommand}"/>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
