<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.MainWindow" Width="1140" Height="800" MinWidth="900" MinHeight="650" Title="阅记 · 阅读与书摘" DataContext="{Binding MainWindowViewModel, Source={StaticResource ServiceLocator}}" Content="{Binding Content}"><i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding MainWindowViewModel.OnInitializedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors></Window>
