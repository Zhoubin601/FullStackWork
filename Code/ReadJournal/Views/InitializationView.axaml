<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.InitializationView"><i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding InitializationViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="18"><TextBlock Classes="h1" Text="阅记"/><TextBlock Text="正在准备本地阅读空间"/><TextBlock Text="正在初始化…" IsVisible="{Binding IsBusy}" Classes="muted"/><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap" MaxWidth="600"/><Button Content="重试初始化" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/></StackPanel></UserControl>
