<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.StatisticsView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding StatisticsViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<ScrollViewer><StackPanel Spacing="22"><TextBlock Classes="h1" Text="阅读统计"/><TextBlock Classes="muted" Text="统计覆盖全部书籍和有效记录，累计页数只来自手动记录（含重读）；时长包含电子书自动会话。" TextWrapping="Wrap"/><Border BorderBrush="#8094A49C" BorderThickness="1" Padding="24" CornerRadius="12"><TextBlock Classes="h2" Text="{Binding StatisticsData.Summary}" TextWrapping="Wrap"/></Border><TextBlock Classes="h2" Text="近七日阅读趋势（上：手动页数，下：阅读时长）"/><ItemsControl ItemsSource="{Binding StatisticsData.LastSevenDays}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="300,*" RowDefinitions="Auto,Auto" Margin="0,8"><TextBlock Text="{Binding Label}"/><ProgressBar Grid.Column="1" Maximum="100" Value="{Binding BarValue}" Height="8" VerticalAlignment="Center"/><ProgressBar Grid.Column="1" Grid.Row="1" Maximum="100" Value="{Binding DurationBarValue}" Height="8" Margin="0,5" Foreground="#C08B42"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><Button Content="刷新 / 重试" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/></StackPanel></ScrollViewer>
</UserControl>
