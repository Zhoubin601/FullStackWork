<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="using:ReadJournal.Reader" x:Class="ReadJournal.Views.ReaderView">
<Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
<TextBlock Text="{Binding Title}" Classes="h2"/>
<WrapPanel Grid.Row="1"><TextBlock Text="字体" VerticalAlignment="Center"/><TextBox Text="{Binding FontFamily}" Width="170" Margin="6,0"/><TextBox Text="{Binding FontSizeText}" Width="60" Margin="0,0,6,0"/><ComboBox SelectedItem="{Binding Palette}" Width="100" Margin="0,0,6,0"><x:String>paper</x:String><x:String>light</x:String><x:String>dark</x:String></ComboBox><Button Content="应用排版" Command="{Binding ApplyAppearanceCommand}" Margin="0,0,6,0"/><Button Content="全屏 F11" Command="{Binding FullScreenCommand}"/></WrapPanel>
<StackPanel Grid.Row="2"><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><TextBlock Text="{Binding Notice}" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" IsVisible="{Binding IsCloseFailed}"><Button Content="重试保存并返回" Command="{Binding RetryCloseCommand}"/><Button Content="继续阅读" Command="{Binding ContinueReadingCommand}" Margin="8,0"/></StackPanel></StackPanel>
<Grid Grid.Row="3" ColumnDefinitions="150,*,300"><ScrollViewer><ItemsControl ItemsSource="{Binding TableOfContents}"><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Title}" Command="{Binding $parent[UserControl].DataContext.GoToChapterCommand}" CommandParameter="{Binding}" Margin="0,4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer><r:ReaderSurface Name="Surface" Grid.Column="1" Page="{Binding Page}" Selection="{Binding Selection}" MinWidth="180" MinHeight="120"/><Border Grid.Column="2" BorderThickness="1,0,0,0" BorderBrush="#8094A49C" Padding="12,0,0,0" Margin="10,0,0,0"><ScrollViewer><StackPanel Spacing="8"><TextBlock Text="AI 阅读助手" Classes="h2"/>
<TextBlock Text="生成书摘会自动保存；原句核验不代表AI解读正确。" TextWrapping="Wrap" Classes="muted"/>
<ComboBox ItemsSource="{Binding AiScopes}" SelectedItem="{Binding AiScope}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsAiBusy}"/>
<StackPanel Orientation="Horizontal" Spacing="6"><TextBox Width="115" Watermark="全书起始页" Text="{Binding AiFirstPage}" IsEnabled="{Binding !IsAiBusy}"/><TextBox Width="115" Watermark="全书结束页" Text="{Binding AiLastPage}" IsEnabled="{Binding !IsAiBusy}"/></StackPanel>
<WrapPanel><Button Content="分析所选范围" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding !IsAiBusy}" Margin="0,0,6,6"/><Button Content="解释选区" Command="{Binding ExplainCommand}" IsEnabled="{Binding !IsAiBusy}" Margin="0,0,0,6"/></WrapPanel>
<Button Content="生成并自动保存书摘" Command="{Binding GenerateQuotesCommand}" IsEnabled="{Binding !IsAiBusy}"/>
<Button Content="取消AI任务" Command="{Binding CancelAiCommand}" IsVisible="{Binding IsAiBusy}"/>
<TextBlock Text="{Binding AiStatus}" TextWrapping="Wrap"/>
<TextBox Text="{Binding AiResult,Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="260"/>
<Button Content="重试本地保存（不重新生成）" Command="{Binding RetryAiSaveCommand}" IsVisible="{Binding CanRetryAiSave}"/>
<Button Content="撤销本批新增书摘" Command="{Binding UndoAiCommand}" IsVisible="{Binding CanUndoAi}"/>
</StackPanel></ScrollViewer></Border></Grid>
<Grid Grid.Row="4" ColumnDefinitions="Auto,*,Auto"><Button Content="← 上一页" Command="{Binding PreviousCommand}"/><TextBlock Grid.Column="1" Text="{Binding IndexText}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button Grid.Column="2" Content="下一页 →" Command="{Binding NextCommand}"/></Grid>
<WrapPanel Grid.Row="5" Margin="0,8,0,0"><Button Content="复制选区 Ctrl+C" Command="{Binding CopySelectionCommand}" Margin="0,0,6,0"/><Button Content="保存书摘 Ctrl+S" Command="{Binding SaveSelectionCommand}" Margin="0,0,6,0"/><Button Content="标记读完" Command="{Binding MarkCompletedCommand}" Margin="0,0,6,0"/><Button Content="重置进度" Command="{Binding ResetProgressCommand}"/><TextBlock Text="位置百分比表示当前位置，不代表阅读覆盖率。Shift+单击可延伸选区。" TextWrapping="Wrap" Margin="8,8"/></WrapPanel></Grid></UserControl>
