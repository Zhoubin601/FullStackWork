<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:r="using:ReadJournal.Reader" x:Class="ReadJournal.Views.ReaderView">
  <UserControl.Styles>
    <Style Selector="ToggleButton.reader-panel">
      <Setter Property="MinHeight" Value="38"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleButton.reader-panel /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceMutedBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
      <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
    </Style>
    <Style Selector="ToggleButton.reader-panel:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="ToggleButton.reader-panel:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppSurfaceHoverBrush}"/>
    </Style>
    <Style Selector="ToggleButton.reader-panel:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AppAccentHoverBrush}"/>
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto">
    <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,8">
      <TextBlock Text="{Binding Title}" Classes="h1" TextTrimming="CharacterEllipsis"/>
      <WrapPanel>
        <ToggleButton Name="TocToggle" Classes="reader-panel" Content="章节目录" IsChecked="{Binding IsTocExpanded,Mode=TwoWay}" Margin="0,0,8,4" ToolTip.Tip="展开或收起章节目录" AutomationProperties.Name="展开或收起章节目录"/>
        <ToggleButton Name="AppearanceToggle" Classes="reader-panel" Content="排版设置" IsChecked="{Binding IsAppearanceExpanded,Mode=TwoWay}" Margin="0,0,8,4" ToolTip.Tip="展开或收起排版设置" AutomationProperties.Name="展开或收起排版设置"/>
        <ToggleButton Name="AiToggle" Classes="reader-panel" Content="AI 助手" IsChecked="{Binding IsAiExpanded,Mode=TwoWay}" Margin="0,0,8,4" ToolTip.Tip="展开或收起AI阅读助手" AutomationProperties.Name="展开或收起AI阅读助手"/>
        <Button Classes="secondary" Content="全屏 F11" Command="{Binding FullScreenCommand}" Margin="0,0,8,4"/>
        <TextBlock Text="AI处理中…" IsVisible="{Binding IsAiBusy}" VerticalAlignment="Center" Margin="0,0,8,4"/>
        <Button Classes="danger" Content="取消AI任务" Command="{Binding CancelAiCommand}" IsVisible="{Binding IsAiBusy}" Margin="0,0,0,4"/>
      </WrapPanel>
    </StackPanel>

    <Border Name="AppearancePanel" Grid.Row="1" IsVisible="{Binding IsAppearanceExpanded}" Classes="card-compact" Padding="14,10" Margin="0,0,0,8">
      <WrapPanel VerticalAlignment="Center">
        <TextBlock Text="字体" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Text="{Binding FontFamily}" Width="165" Margin="0,0,10,0" ToolTip.Tip="输入正文字体名称"/>
        <TextBlock Text="字号" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <TextBox Text="{Binding FontSizeText}" Width="58" Margin="0,0,10,0" ToolTip.Tip="输入字号大小"/>
        <TextBlock Text="纸张" Classes="muted" VerticalAlignment="Center" Margin="0,0,6,0"/>
        <ComboBox SelectedItem="{Binding Palette}" Width="100" Margin="0,0,10,0" ToolTip.Tip="选择阅读纸张主题 (paper/light/dark)">
          <x:String>paper</x:String>
          <x:String>light</x:String>
          <x:String>dark</x:String>
        </ComboBox>
        <Button Classes="primary" Content="应用排版" Command="{Binding ApplyAppearanceCommand}" Margin="0,0,8,0"/>
      </WrapPanel>
    </Border>

    <StackPanel Grid.Row="2" Spacing="4" Margin="0,0,0,6">
      <TextBlock Text="{Binding Error}" Classes="danger-text" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Notice}" Classes="muted" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsCloseFailed}">
        <Button Classes="primary" Content="重试保存并返回" Command="{Binding RetryCloseCommand}"/>
        <Button Classes="secondary" Content="继续阅读" Command="{Binding ContinueReadingCommand}"/>
      </StackPanel>
    </StackPanel>

    <Grid Name="ReadingPanels" Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
      <Border Name="TocPanel" Grid.Column="0" Width="164" IsVisible="{Binding IsTocExpanded}" Classes="card-compact" Padding="8,10" Margin="0,0,10,0">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="章节目录" Classes="h3" Margin="6,0,6,8"/>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding TableOfContents}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Classes="toc-item"
                          Content="{Binding Title}"
                          Command="{Binding $parent[UserControl].DataContext.GoToChapterCommand}"
                          CommandParameter="{Binding}"
                          Margin="0,2"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource AppReaderFrameBgBrush}"
              BorderBrush="{DynamicResource AppBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="2"
              ClipToBounds="True">
        <r:ReaderSurface Name="Surface"
                         Page="{Binding Page}"
                         Selection="{Binding Selection}"
                         MinWidth="180"
                         MinHeight="120"/>
      </Border>

      <Border Name="AiPanel" Grid.Column="2" Width="304" IsVisible="{Binding IsAiExpanded}" Classes="card-compact" Padding="14,12" Margin="10,0,0,0">
        <ScrollViewer>
          <StackPanel Spacing="10">
            <StackPanel Spacing="4">
              <TextBlock Text="AI 阅读助手" Classes="h2"/>
              <TextBlock Text="AI解读只显示结果；生成书摘会自动保存。" TextWrapping="Wrap" Classes="muted" FontSize="12"/>
            </StackPanel>

            <ComboBox ItemsSource="{Binding AiScopes}"
                      SelectedItem="{Binding AiScope}"
                      HorizontalAlignment="Stretch"
                      IsEnabled="{Binding !IsAiBusy}"/>
            <TextBlock Text="{Binding AiScopeDescription}" TextWrapping="Wrap" Classes="muted" FontSize="12"/>

            <Grid Name="AiPageRangeInputs" ColumnDefinitions="*,*" IsVisible="{Binding IsAiPageRange}">
              <TextBox Grid.Column="0" Watermark="全书起始页" Text="{Binding AiFirstPage}" IsEnabled="{Binding !IsAiBusy}" Margin="0,0,4,0"/>
              <TextBox Grid.Column="1" Watermark="全书结束页" Text="{Binding AiLastPage}" IsEnabled="{Binding !IsAiBusy}" Margin="4,0,0,0"/>
            </Grid>

            <Button Classes="secondary" Content="AI 解读" Command="{Binding AnalyzeCommand}" IsEnabled="{Binding CanRunAi}" HorizontalAlignment="Stretch"/>

            <Button Classes="primary"
                    Content="生成并自动保存书摘"
                    Command="{Binding GenerateQuotesCommand}"
                    IsEnabled="{Binding CanRunAi}"
                    HorizontalAlignment="Stretch"/>

            <TextBlock Text="{Binding AiStatus}" TextWrapping="Wrap" FontSize="13" FontWeight="Medium"/>

            <TextBox Text="{Binding AiResult,Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="110"
                     MaxHeight="250"/>

            <Button Classes="secondary"
                    Content="重试本地保存（不重新生成）"
                    Command="{Binding RetryAiSaveCommand}"
                    IsVisible="{Binding CanRetryAiSave}"
                    HorizontalAlignment="Stretch"/>

            <Button Classes="danger"
                    Content="撤销本批新增书摘"
                    Command="{Binding UndoAiCommand}"
                    IsVisible="{Binding CanUndoAi}"
                    HorizontalAlignment="Stretch"/>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <Border Grid.Row="4" Classes="card-compact" Padding="12,8" Margin="0,0,0,8">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="secondary" Content="← 上一页" Command="{Binding PreviousCommand}"/>
        <TextBlock Grid.Column="1" Text="{Binding IndexText}" FontWeight="Medium" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Button Grid.Column="2" Classes="secondary" Content="下一页 →" Command="{Binding NextCommand}"/>
      </Grid>
    </Border>

    <WrapPanel Grid.Row="5" VerticalAlignment="Center">
      <Button Classes="secondary" Content="复制选区 Ctrl+C" Command="{Binding CopySelectionCommand}" Margin="0,0,8,0"/>
      <Button Classes="primary" Content="保存书摘 Ctrl+S" Command="{Binding SaveSelectionCommand}" Margin="0,0,8,0"/>
      <Button Classes="secondary" Content="标记读完" Command="{Binding MarkCompletedCommand}" Margin="0,0,8,0"/>
      <Button Classes="danger" Content="重置进度" Command="{Binding ResetProgressCommand}" Margin="0,0,12,0"/>
      <TextBlock Text="位置百分比表示当前位置，不代表阅读覆盖率。Shift+单击可延伸选区。" Classes="muted" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
    </WrapPanel>
  </Grid>
</UserControl>
