<UserControl xmlns:vm="using:ReadJournal.Library.ViewModels" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.MainView" Background="{DynamicResource AppBackgroundBrush}">
  <Grid ColumnDefinitions="224,*">
    <Border Classes="nav" Background="{DynamicResource AppSidebarBgBrush}" Padding="18,26">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="6,0,6,24">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="34" Height="34" CornerRadius="8" Background="#2E6F5E" VerticalAlignment="Center">
              <PathIcon Data="{StaticResource IconBooks}" Width="18" Height="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Spacing="1" VerticalAlignment="Center">
              <TextBlock Text="阅 记" FontSize="22" FontWeight="Bold" Foreground="White"/>
              <TextBlock Text="ReadJournal" FontSize="11" Foreground="#8FB3A8"/>
            </StackPanel>
          </StackPanel>
          <TextBlock Text="让每一页，留下回响" FontSize="12" Foreground="#B5CEC6" Margin="2,6,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Padding="10,8" CornerRadius="8" Background="#14FFFFFF" Margin="2,16,2,0">
          <TextBlock Text="本地优先 · 隐私安全阅读空间" FontSize="11" Foreground="#A8C5BC" HorizontalAlignment="Center"/>
        </Border>

        <ItemsControl ItemsSource="{x:Static vm:MenuItem.MenuItems}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes.active="{Binding IsSelected}"
                      AutomationProperties.Name="{Binding Name}"
                      Margin="0,3"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Left"
                      Command="{Binding $parent[UserControl].DataContext.OnMenuTappedCommand}"
                      CommandParameter="{Binding}">
                <Grid ColumnDefinitions="4,22,*">
                  <Border Width="4" Height="18" CornerRadius="2" Background="#6EE7B7" IsVisible="{Binding IsSelected}" VerticalAlignment="Center" Margin="-6,0,6,0"/>
                  <PathIcon Grid.Column="1" Data="{Binding IconData}" Width="15" Height="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="White" VerticalAlignment="Center" FontSize="14"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
      <Border Background="{DynamicResource AppHeaderBgBrush}"
              Padding="28,12"
              BorderThickness="0,0,0,1"
              BorderBrush="{DynamicResource AppBorderBrush}"
              IsVisible="{Binding CanGoBack}">
        <DockPanel>
          <Button DockPanel.Dock="Left"
                  Classes="secondary"
                  Content="← 返回"
                  IsVisible="{Binding CanGoBack}"
                  ToolTip.Tip="返回当前模块的上一页"
                  Command="{Binding GoBackCommand}"
                  Margin="0,0,14,0"/>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="muted" Text="当前所属模块：" VerticalAlignment="Center"/>
            <TextBlock Classes="h3" Text="{Binding Title}" VerticalAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Border>
      <ContentControl Grid.Row="1" Content="{Binding Content}" Margin="28,22"/>
    </Grid>
  </Grid>
</UserControl>
