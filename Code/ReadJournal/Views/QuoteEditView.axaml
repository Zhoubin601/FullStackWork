<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.QuoteEditView">
<i:Interaction.Behaviors><ia:EventTriggerBehavior EventName="Loaded"><ia:InvokeCommandAction Command="{Binding QuoteEditViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/></ia:EventTriggerBehavior></i:Interaction.Behaviors>
<ScrollViewer><StackPanel Spacing="10" MaxWidth="720" HorizontalAlignment="Stretch"><TextBlock Classes="h1" Text="整理书摘" Margin="0,0,0,12"/><TextBlock Text="关联书籍 *"/><ComboBox ItemsSource="{Binding BooksList}" SelectedItem="{Binding SelectedBook,Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="摘录正文 *"/><TextBox Text="{Binding Text,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/><TextBlock Text="个人感想"/><TextBox Text="{Binding Thoughts,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/><TextBlock Text="页码（可留空）"/><TextBox Text="{Binding Page,Mode=TwoWay}"/><CheckBox Content="加入收藏" IsChecked="{Binding IsFavorite,Mode=TwoWay}"/><TextBlock Text="{Binding Error}" Foreground="Crimson" TextWrapping="Wrap"/><TextBlock Text="正在处理…" IsVisible="{Binding IsBusy}" Classes="muted"/><StackPanel Orientation="Horizontal" Spacing="14" Margin="0,12"><Button Content="保存并返回" Command="{Binding SaveCommand}"/><TextBlock Text="有未保存修改" IsVisible="{Binding IsDirty}" VerticalAlignment="Center" Classes="muted"/></StackPanel></StackPanel></ScrollViewer>
</UserControl>
