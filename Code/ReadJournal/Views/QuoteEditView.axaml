<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.QuoteEditView">
  <i:Interaction.Behaviors>
    <ia:EventTriggerBehavior EventName="Loaded">
      <ia:InvokeCommandAction Command="{Binding QuoteEditViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/>
    </ia:EventTriggerBehavior>
  </i:Interaction.Behaviors>
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="760" HorizontalAlignment="Left" Margin="0,0,0,16">
      <StackPanel Spacing="4">
        <TextBlock Classes="h1" Text="整理书摘"/>
        <TextBlock Classes="muted" Text="记录触动你的原文段落与随想批注"/>
      </StackPanel>

      <Border Classes="card" Padding="24,20">
        <StackPanel Spacing="14">
          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="关联书籍 *"/>
            <ComboBox IsEnabled="{Binding !IsBusy}" ItemsSource="{Binding BooksList}" SelectedItem="{Binding SelectedBook,Mode=TwoWay}" HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Title}"/>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <Border Classes="surface-muted" Padding="14,10" IsVisible="{Binding OriginalText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <StackPanel Spacing="6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Classes="secondary" Content="回到原文" Command="{Binding OpenOriginalCommand}"/>
                <Border Classes="badge" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <TextBlock Classes="badge-text" Text="{Binding SourceLabel}" TextWrapping="Wrap"/>
                </Border>
              </DockPanel>
              <TextBlock Text="来源原文（保留用于精确回跳）" Classes="muted" FontSize="12"/>
              <TextBlock Text="{Binding OriginalText}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="摘录正文 *"/>
            <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding Text,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96"/>
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="h3" Text="个人感想"/>
            <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding Thoughts,Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88"/>
          </StackPanel>

          <Grid ColumnDefinitions="220,*">
            <StackPanel Grid.Column="0" Spacing="6">
              <TextBlock Classes="h3" Text="页码（可留空）"/>
              <TextBox IsEnabled="{Binding !IsBusy}" Text="{Binding Page,Mode=TwoWay}"/>
            </StackPanel>
            <CheckBox Grid.Column="1" IsEnabled="{Binding !IsBusy}" Content="加入收藏" IsChecked="{Binding IsFavorite,Mode=TwoWay}" VerticalAlignment="Bottom" Margin="18,0,0,6"/>
          </Grid>

          <Border Classes="error-banner" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock Text="{Binding Error}" Classes="danger-text" TextWrapping="Wrap"/>
          </Border>
          <TextBlock Text="正在处理…" IsVisible="{Binding IsBusy}" Classes="muted"/>

          <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,6,0,0">
            <Button Classes="primary" IsEnabled="{Binding !IsBusy}" Content="保存并返回" Command="{Binding SaveCommand}"/>
            <Button Classes="secondary" IsEnabled="{Binding !IsBusy}" Content="重新加载" Command="{Binding OnLoadedCommand}"/>
            <Border Classes="badge-amber" IsVisible="{Binding IsDirty}" VerticalAlignment="Center">
              <TextBlock Classes="badge-amber-text" Text="有未保存修改"/>
            </Border>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
