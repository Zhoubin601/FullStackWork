<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:i="using:Avalonia.Xaml.Interactivity" xmlns:ia="using:Avalonia.Xaml.Interactions.Core" x:Class="ReadJournal.Views.ReadingPlanListView">
  <i:Interaction.Behaviors>
    <ia:EventTriggerBehavior EventName="Loaded">
      <ia:InvokeCommandAction Command="{Binding ReadingPlanListViewModel.OnLoadedCommand,Source={StaticResource ServiceLocator}}"/>
    </ia:EventTriggerBehavior>
  </i:Interaction.Behaviors>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <DockPanel Grid.Row="0" Margin="0,0,0,12">
      <Button DockPanel.Dock="Right" Classes="primary" Content="＋ 制定计划" Command="{Binding AddPlanCommand}"/>
      <StackPanel Spacing="2">
        <TextBlock Classes="h1" Text="阅读计划"/>
        <TextBlock Classes="muted" Text="设定目标完成日期，自动核算每日建议阅读量"/>
      </StackPanel>
    </DockPanel>

    <Border Grid.Row="1" Classes="card-compact" Padding="14,10" Margin="0,0,0,10">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ComboBox Width="160" ItemsSource="{Binding States}" SelectedItem="{Binding State,Mode=TwoWay}"/>
        <Button Classes="primary" Content="筛选 / 刷新" Command="{Binding OnLoadedCommand,FallbackValue={x:Null}}"/>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="2" Text="{Binding Error}" Classes="danger-text" TextWrapping="Wrap" Margin="0,0,0,8"/>

    <ScrollViewer Grid.Row="3">
      <StackPanel Spacing="2">
        <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="32,28" Margin="0,12">
          <StackPanel HorizontalAlignment="Center" Spacing="10">
            <PathIcon Data="{StaticResource IconPlans}" Width="28" Height="28" Foreground="{DynamicResource AppAccentBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="没有匹配的计划。先为一本书设定阅读目标吧。" Classes="muted" HorizontalAlignment="Center"/>
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding PlansList}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="card" Padding="20,16" Margin="0,0,0,12">
                <StackPanel Spacing="10">
                  <DockPanel>
                    <Border DockPanel.Dock="Right" Classes="badge-amber">
                      <TextBlock Classes="badge-amber-text" Text="{Binding State}"/>
                    </Border>
                    <TextBlock Classes="h2" Text="{Binding Progress.Book.Title}" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock Text="{Binding Deadline}" Classes="muted"/>
                  <TextBlock Text="{Binding Suggestion}" FontWeight="Medium"/>
                  <ProgressBar Maximum="100" Value="{Binding Progress.Percent}" Height="6"/>
                  <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                    <Button Classes="secondary" Content="编辑计划" Command="{Binding $parent[UserControl].DataContext.EditPlanCommand}" CommandParameter="{Binding}"/>
                    <Button Classes="danger" Content="删除计划" Command="{Binding $parent[UserControl].DataContext.DeletePlanCommand}" CommandParameter="{Binding}"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
